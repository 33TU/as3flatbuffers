            const position16:uint = as3flatbuffers.Unpack.fieldOffset(vtable, vtableSize, objectSize, base, 36, 4);
            if (!position16)
            {
                destination.entriesView = 0;
            }
            else
            {
                destination.entriesView = li32(position16);
            }
            return destination;
        }
    }
}
