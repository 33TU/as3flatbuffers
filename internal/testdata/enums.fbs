namespace fixtures.enums;

enum I8:byte { Min = -128, Zero = 0, Max = 127 }
enum U8:ubyte { Zero = 0, Max = 255 }
enum I16:short { Min = -32768, Zero = 0, Max = 32767 }
enum U16:ushort { Zero = 0, Max = 65535 }
enum I32:int { Min = -2147483648, Zero = 0, Max = 2147483647 }
enum U32:uint { Zero = 0, Max = 4294967295 }
enum I64:long { Min = -9223372036854775808, Zero = 0, Large = 9007199254740993, Max = 9223372036854775807 }
enum U64:ulong { Zero = 0, Large = 9007199254740993, Max = 18446744073709551615 }
enum Mode:ubyte { None = 0, Hot = 1, hot = 2 }
enum Flags:uint (bit_flags) { Read = 0, Write = 1, Execute = 7 }

struct EnumStruct { a:I8; b:U8; c:I16; d:U16; e:I32; f:U32; g:I64; h:U64; }
table Enums {
 a:I8 = Min;
 b:U8;
 c:I16 = Min;
 d:U16;
 e:I32 = Min;
 f:U32;
 g:I64 = Large;
 h:U64;
 av:[I8];
 bv:[U8];
 cv:[I16];
 dv:[U16];
 ev:[I32];
 fv:[U32];
 gv:[I64];
 hv:[U64];
 optional_mode:Mode = null;
 optional_wide:U64 = null;
 state:EnumStruct;
 flags:Flags;
}
root_type Enums;
